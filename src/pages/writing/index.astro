---
import Layout from '../../layouts/Layout.astro';
import {writing} from '../../lib/content';
const tags=[...new Set(writing.map(p=>p.frontmatter.tag))];
---
<Layout title="Writing"><div class="page-intro"><h1>Writing</h1><p>Field notes on staffing systems, backend reliability and applied AI.</p></div>{!writing.length && <p>My published engineering work is collected in the <a href="/work/">case studies</a>.</p>}<nav aria-label="Topics">{tags.map((tag,i)=><a href={'#topic-'+i}>{tag}</a>)}</nav>{tags.map((tag,i)=><section id={'topic-'+i}><h2>{tag}</h2>{writing.filter(p=>p.frontmatter.tag===tag).map(({frontmatter:f})=><article class="row"><h3><a href={'/writing/'+f.slug+'/'}>{f.title}</a></h3><p>{f.summary}</p></article>)}</section>)}</Layout>
