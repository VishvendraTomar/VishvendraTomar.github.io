---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import {cases, writing} from '../lib/content';
---
<Layout><section class="hero"><div><span class="eyebrow">Vishvendra Tomar · Backend engineer</span><h1>I build backends for staffing software.</h1><p>I built most of the backend for a Belgian staffing platform from Bengaluru and spent about 20 days in Belgium for final delivery.</p><div class="actions"><a class="primary" href="/work/workforce-infrastructure/">Read the staffing case study</a><a href="/contact/">Discuss contract work</a></div></div><aside class="proof" aria-label="Public platform figures"><small>Belgian staffing platform · public figures</small><p><strong>125,000+</strong> shifts, up from about 10,000</p><strong>1,000+</strong> companies</aside></section>
<section id="work" class="section"><h2>Selected case studies</h2><div class="cards">{cases.map(({frontmatter:f})=><article class="card"><Figure id={f.figure} compact/><h3><a href={'/work/'+f.slug+'/'}>{f.title}</a></h3><p>{f.summary}</p></article>)}</div></section>
{writing.length > 0 && <section class="section"><h2>Latest writing</h2>{writing.slice(0,3).map(({frontmatter:f})=><div class="row"><a href={'/writing/'+f.slug+'/'}>{f.title}</a></div>)}<a href="/writing/">All writing</a></section>}<section class="section"><h2>Working on staffing or payroll software?</h2><p>I take on contract backend and AI work for workforce teams.</p><a href="/contact/">Get in touch</a></section></Layout>
