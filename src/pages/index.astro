---
import Layout from '../layouts/Layout.astro';
const projects = [
  {num:'01',eyebrow:'BACKEND SYSTEMS',name:'Workforce infrastructure',short:'Modernising the backend of a workforce platform.',detail:'FastAPI services, a PostgreSQL data model, background tasks and the business rules behind shifts and payments.',stack:['Python','FastAPI','PostgreSQL','Celery'],kind:'system',slug:'workforce-infrastructure'},
  {num:'02',eyebrow:'WORKFLOW AUTOMATION',name:'AntAgents',short:'Connecting processes, people and AI.',detail:'Visual workflows, agent steps, execution state and asynchronous processing in a modular automation platform.',stack:['TypeScript','NestJS','Redis','Docker'],kind:'flow',slug:'antagents'},
  {num:'03',eyebrow:'APPLIED AI',name:'Developer tooling',short:'Making language models useful in real workflows.',detail:'Structured outputs, retrieval, code analysis and the engineering around predictable model integrations.',stack:['Python','LLM APIs','RAG'],kind:'code',slug:'ai-developer-tooling'}
];
const capabilities=[
  {num:'01',name:'Backend',items:'Python, FastAPI, Node.js, TypeScript'},
  {num:'02',name:'Data & jobs',items:'PostgreSQL, Redis, Celery, Firestore'},
  {num:'03',name:'Applied AI',items:'LLM APIs, retrieval, structured outputs'},
  {num:'04',name:'Delivery',items:'Docker, observability, Flutter, CI/CD'}
];
---
<Layout>
<div class="shell" id="top">
  <header class="header wrap">
    <a href="#top" class="brand" aria-label="Vishvendra Tomar — home"><span class="brand-icon">V<span>✦</span>T</span><span class="brand-text">VISHVENDRA<br/>TOMAR</span></a>
    <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#inside">Explore</a><a href="#about">About</a><a href="#experience">Experience</a></nav>
    <a class="header-contact" href="mailto:vishvendratomar29@gmail.com">Let's talk <span aria-hidden="true">↗</span></a>
  </header>
  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-overline"><span class="small-rule"></span><span>VISHVENDRA TOMAR / BACKEND ENGINEERING</span><span class="hero-no">01 — 04</span></div>
      <h1 id="hero-title"><span class="hero-line">I build the</span><br/><span class="hero-line serif">systems behind</span><br/><span class="hero-line">the product<span class="blue-stop">.</span></span></h1>
      <div class="hero-bottom">
        <p>I'm Vishvendra Tomar, a software engineer focused on backend systems and applied AI. I turn complex workflows into software people can rely on.</p>
        <a href="#work" class="round-link" aria-label="Explore selected work"><span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-end"><span>PYTHON / FASTAPI / PRODUCT ENGINEERING</span><span>SCROLL TO EXPLORE ↓</span></div>
    </section>
    <div class="blue-band" aria-hidden="true"></div>
    <section class="work light-section" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <div class="section-intro"><span class="overline"><span class="section-index">01</span> SELECTED WORK</span><div><h2 id="work-title">Proof is in<br/><em>the work.</em></h2><p>Three areas that reflect what I build.</p></div></div>
        <div class="project-list">
          {projects.map((p)=>(
            <article class="project">
              <div class="project-info">
                <div class="project-top"><span>{p.num} / {p.eyebrow}</span><span aria-hidden="true">↗</span></div>
                <div class="project-main"><h3>{p.name}</h3><p class="project-short">{p.short}</p><p class="project-detail">{p.detail}</p></div>
                <div class="project-tags">{p.stack.map(t=><span>{t}</span>)}</div><a class="case-link" href={`/work/${p.slug}/`} aria-label={`Read ${p.name} case study`}>Read the case study <span aria-hidden="true">↗</span></a>
              </div>
              <div class={'project-art '+p.kind} aria-hidden="true">
                {p.kind==='system' && <div class="artboard">
                  <div class="art-label"><span>WORKFLOW / 01</span><span class="art-light">● LIVE</span></div>
                  <div class="art-nodes"><span>API<br/>REQUEST</span><b>→</b><span>DOMAIN<br/>RULES</span><b>→</b><span>ASYNC<br/>JOB</span></div>
                  <div class="art-status"><span>DATA / POSTGRES</span><span>STATUS: HEALTHY</span></div>
                </div>}
                {p.kind==='flow' && <div class="artboard">
                  <div class="art-label"><span>AGENT ORCHESTRATION</span><span>02 / 03</span></div>
                  <div class="flow-stack"><span>TRIGGER <i>DONE</i></span><div class="flow-connector"></div><span class="flow-active">AGENT STEP <i>↗</i></span><div class="flow-connector"></div><span>RESULT <i>○</i></span></div>
                </div>}
                {p.kind==='code' && <div class="artboard code-art">
                  <div class="art-label code-head"><span>AI PIPELINE</span><span class="code-brand"><span class="code-spark" aria-hidden="true">✦</span>03 / 03</span></div>
                  <div class="code-lines">
                    <span class="code-row"><i>01</i><code>context = retrieve(query)</code></span>
                    <span class="code-row"><i>02</i><code>result = model.generate(</code></span>
                    <span class="code-row"><i>03</i><code>  context, schema, rules</code></span>
                    <span class="code-row"><i>04</i><code>)</code></span>
                    <span class="code-row"><i>05</i><code>return validate(result)</code></span>
                  </div>
                </div>}
                <span class="visual-caption">VISHVENDRA / SELECTED WORK</span>
              </div>
            </article>
          ))}
        </div>
        <p class="work-disclaimer">Commercial projects are discussed without publishing private code or confidential information.</p>
      </div>
    </section>

    <section class="inside-section dark-section" id="inside" aria-labelledby="inside-title">
      <div class="wrap">
        <div class="section-intro inside-head"><span class="overline"><span class="section-index">↳</span> INTERACTIVE EXPLORATION</span><div><h2 id="inside-title">Inside the<br/><em>system.</em></h2><p>Tap a component. See the engineering behind the experience.</p></div></div>
        <div class="inside-demo">
          <div class="demo-top"><span class="demo-kicker"><span class="demo-live" aria-hidden="true"></span> ARCHITECTURE EXPLORER</span><span class="demo-id">REFERENCE DESIGN / NOT A LIVE SERVICE</span></div>
          <div class="demo-layout">
            <div class="demo-map">
              <div class="map-label">AI CUSTOMER SUPPORT / REQUEST LIFECYCLE</div>
              <div class="map-steps" role="group" aria-label="Explore architecture components">
                <button type="button" class="map-node is-selected" data-step="0" aria-pressed="true"><span class="map-count">01</span><span class="map-node-copy"><strong>Customer request</strong><small>Entry &amp; identity</small></span><span class="map-arrow">↗</span></button>
                <span class="map-connector" aria-hidden="true"></span>
                <button type="button" class="map-node" data-step="1" aria-pressed="false"><span class="map-count">02</span><span class="map-node-copy"><strong>FastAPI orchestration</strong><small>Context &amp; routing</small></span><span class="map-arrow">↗</span></button>
                <span class="map-connector" aria-hidden="true"></span>
                <div class="map-sources">
                  <button type="button" class="map-node" data-step="2" aria-pressed="false"><span class="map-count">03</span><span class="map-node-copy"><strong>Policy retrieval</strong><small>Approved knowledge</small></span><span class="map-arrow">↗</span></button>
                  <button type="button" class="map-node" data-step="3" aria-pressed="false"><span class="map-count">04</span><span class="map-node-copy"><strong>Live user context</strong><small>Permission-aware data</small></span><span class="map-arrow">↗</span></button>
                </div>
                <span class="map-connector" aria-hidden="true"></span>
                <button type="button" class="map-node" data-step="4" aria-pressed="false"><span class="map-count">05</span><span class="map-node-copy"><strong>Model + guardrails</strong><small>Grounded answer or escalation</small></span><span class="map-arrow">↗</span></button>
              </div>
            </div>
            <div class="demo-detail" aria-live="polite" aria-atomic="true">
              <div class="detail-overline"><span id="detail-number">COMPONENT 01 / 05</span><span class="detail-spark" aria-hidden="true">✦</span></div>
              <div class="detail-body"><span class="detail-type" id="detail-type">INPUT LAYER</span><h3 id="detail-title">Start with a real question.</h3><p id="detail-description">A support request enters the system. Before generating an answer, the application has to establish who is asking and what information may be used.</p></div>
              <div class="detail-footer"><span id="detail-principle">DESIGN PRINCIPLE / IDENTITY FIRST</span><div class="detail-controls"><button type="button" id="step-prev" aria-label="Previous architecture component">←</button><button type="button" id="step-next" aria-label="Next architecture component">→</button></div></div>
            </div>
          </div>
        </div>
        <div class="inside-bottom"><span>INTERACTIVE CONCEPT / BASED ON AI SUPPORT INFRASTRUCTURE WORK</span><span>BUILT TO EXPLAIN THE THINKING, NOT EXPOSE PRIVATE SYSTEMS</span></div>
      </div>
    </section>
    <section class="about dark-section" id="about" aria-labelledby="about-title">
      <div class="wrap">
        <div class="section-intro"><span class="overline"><span class="section-index">02</span> HOW I THINK</span><div><h2 id="about-title">Beyond the<br/><em>happy path.</em></h2><p>Good engineering shows up when things go wrong.</p></div></div>
        <div class="about-layout"><p class="about-lead">I care about what happens <em>between</em> the layers: the API, the database, the queue, and the user.</p><div class="about-right"><p>My work spans backend architecture, full-stack delivery and AI integrations. I enjoy designing clear boundaries, understanding business rules and debugging the problems that only appear in real systems.</p><a class="text-link" href="https://github.com/VishvendraTomar" target="_blank" rel="noopener noreferrer">Explore my GitHub <span>↗</span></a></div></div>
        <div class="capabilities">{capabilities.map(c=><div class="capability"><span class="cap-number">{c.num}</span><h3>{c.name}</h3><p>{c.items}</p></div>)}</div>
      </div>
    </section>
    <section class="experience light-section" id="experience" aria-labelledby="experience-title"><div class="wrap">
      <div class="section-intro"><span class="overline"><span class="section-index">03</span> EXPERIENCE</span><div><h2 id="experience-title">Built through<br/><em>experience.</em></h2></div></div>
      <div class="timeline"><div class="timeline-row"><span class="dates">2026</span><div><h3>Software Engineer</h3><p>Deel</p><p class="role-detail">Worked on AI customer-support infrastructure: FastAPI orchestration connecting policy knowledge (RAG), live user context, authorized actions, and response guardrails.</p></div><span class="timeline-type">BACKEND / PRODUCT</span></div><div class="timeline-row"><span class="dates">2024 — 2026</span><div><h3>Software Engineer III</h3><p>GeekyAnts · Joined as an intern, grew into SE III</p></div><span class="timeline-type">SOFTWARE ENGINEERING</span></div></div>
    </div></section>
    <section class="contact dark-section" id="contact" aria-labelledby="contact-title"><div class="wrap"><div class="contact-head"><span class="overline"><span class="section-index">04</span> CONTACT</span><span class="contact-spark" aria-hidden="true">✦</span></div><h2 id="contact-title">Let's make<br/><em>something work.</em></h2><div class="contact-bottom"><p>Open to backend and software engineering opportunities.</p><a href="mailto:vishvendratomar29@gmail.com" class="contact-email">Get in touch <span>↗</span></a></div><div class="social-links"><a href="https://github.com/VishvendraTomar" target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href="https://linkedin.com/in/vishvendra-tomar" target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a><a href="mailto:vishvendratomar29@gmail.com">EMAIL ↗</a></div></div></section>
  </main>
  <footer class="footer wrap"><span>© {new Date().getFullYear()} VISHVENDRA TOMAR</span><span>DESIGNED WITH INTENTION</span><a href="#top">BACK TO TOP ↑</a></footer>
</div>
</Layout>
<style>
:global(:root){--charcoal:#1e1e1c;--paper:#d8cbb3;--blue:#2f6bff;--rule-dark:#57554e;--rule-light:#a99f8d;--ink-soft:#8e8a80;--paper-soft:#b4aa98}
.shell{overflow:hidden;background:var(--charcoal);color:var(--paper)}
.wrap{width:min(1180px,calc(100% - 88px));margin:0 auto}
.header{height:105px;display:flex;align-items:center;gap:32px;border-bottom:1px solid var(--rule-dark)}
.brand{display:flex;align-items:center;gap:13px;margin-right:auto}.brand-icon{width:47px;height:47px;border:1px solid var(--paper);display:flex;align-items:center;justify-content:center;font:700 20px 'Space Grotesk',sans-serif;letter-spacing:-2px}.brand-icon span{font-size:9px;color:var(--blue);margin:0 2px;letter-spacing:0}.brand-text{font:500 10px/1.5 'DM Mono',monospace;letter-spacing:1px}
.header nav{display:flex;gap:34px;font-size:12px}.header nav a,.header-contact{transition:color .2s}.header nav a:hover,.header-contact:hover{color:#fff}
.header-contact{border-bottom:1px solid var(--paper);font-weight:600;font-size:12px;padding-bottom:8px}.header-contact span{margin-left:26px;color:var(--blue)}
.hero{padding-top:113px}.hero-overline{display:flex;align-items:center;gap:14px;color:var(--paper-soft);font:10px 'DM Mono',monospace;letter-spacing:1.2px}.small-rule{width:24px;height:3px;background:var(--blue)}.hero-no{margin-left:auto}
.hero h1{font:500 clamp(70px,9.5vw,142px)/1.035 'Space Grotesk',sans-serif;letter-spacing:-.078em;margin:50px 0 60px}.hero .serif,h2 em,.about-lead em{font-family:Georgia,serif;font-weight:400}.hero .serif{font-style:italic;letter-spacing:-.076em}.blue-stop{color:var(--blue)}
.hero-bottom{display:flex;justify-content:space-between;align-items:end;gap:60px}.hero-bottom p{max-width:495px;font-size:17px;line-height:1.8;color:var(--paper-soft);margin:0}
.round-link{flex:none;display:grid;place-items:center;width:72px;height:72px;border:1px solid var(--paper);border-radius:50%;font-size:29px;transition:background .2s,color .2s,transform .2s}.round-link:hover{background:var(--blue);border-color:var(--blue);color:white;transform:translateY(3px)}
.hero-end{display:flex;justify-content:space-between;gap:20px;padding:23px 0 27px;margin-top:100px;border-top:1px solid var(--rule-dark);font:10px 'DM Mono',monospace;letter-spacing:1px;color:var(--paper-soft)}.blue-band{height:7px;background:var(--blue)}
.light-section{background:var(--paper);color:var(--charcoal)}.dark-section{background:var(--charcoal);color:var(--paper)}
.work,.about,.experience,.contact{padding:120px 0 130px}.section-intro{display:grid;grid-template-columns:32% 1fr;gap:30px;align-items:start;margin-bottom:60px}
.overline{font:11px 'DM Mono',monospace;letter-spacing:1.2px}.section-index{display:inline-block;color:var(--blue);margin-right:22px;font-weight:500}
.section-intro h2,.contact h2{font:500 clamp(58px,7vw,100px)/1.08 'Space Grotesk',sans-serif;letter-spacing:-.071em;margin:0}.section-intro h2 em,.contact h2 em{letter-spacing:-.065em}
.section-intro>div>p{font-size:15px;line-height:1.65;margin:23px 0 0;color:#615d55}
.dark-section .section-intro>div>p{color:var(--paper-soft)}
.project-list{border-top:1px solid var(--rule-light)}.project{display:grid;grid-template-columns:1fr 1fr;min-height:370px;border-bottom:1px solid var(--rule-light)}.project-info{display:flex;flex-direction:column;min-width:0;padding:34px 40px 34px 0}.project-top{display:flex;justify-content:space-between;align-items:center;gap:20px;font:10px 'DM Mono',monospace;letter-spacing:1px}.project-top>span:last-child{font-size:23px;color:var(--blue)}.project-main{margin:auto 0}.project-main h3{font:500 clamp(28px,3.3vw,44px)/1.1 'Space Grotesk',sans-serif;letter-spacing:-2px;margin:18px 0}.project-short{font-size:16px;font-weight:600;margin:0 0 15px}.project-detail{max-width:420px;color:#615e56;font-size:13px;line-height:1.75;margin:0}.project-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.project-tags span{border:1px solid var(--rule-light);padding:7px 9px;font:10px 'DM Mono',monospace}
.project-art{position:relative;display:flex;align-items:center;justify-content:center;padding:45px;min-width:0;background:#292923;overflow:hidden}.project-art:before{content:'';position:absolute;inset:0;background:linear-gradient(#d8cbb30d 1px,transparent 1px),linear-gradient(90deg,#d8cbb30d 1px,transparent 1px);background-size:34px 34px}.project-art.flow{background:#292823}.project-art.code{background:#252729}
.artboard{position:relative;z-index:1;width:100%;max-width:390px;color:var(--paper);background:#1e1e1c;border:1px solid #7a766c;padding:22px;box-shadow:12px 15px 0 #11110f70;transform:rotate(-2deg)}.art-label,.art-status{display:flex;justify-content:space-between;gap:10px;font:9px 'DM Mono',monospace;color:var(--paper-soft);letter-spacing:.4px}.art-light{color:var(--blue)}.art-nodes{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:42px 0}.art-nodes span{color:var(--paper);border:1px solid #a9a08f;padding:15px 10px;text-align:center;min-width:0;font:10px/1.6 'DM Mono',monospace}.art-nodes b{font-size:14px;font-weight:400;color:var(--blue)}.art-status{padding-top:18px;border-top:1px solid #5d5b53;font-size:8px}.flow-stack{width:190px;margin:25px auto 8px;display:flex;align-items:center;flex-direction:column}.flow-stack>span{color:var(--paper);width:100%;padding:12px 14px;border:1px solid var(--paper-soft);font:10px 'DM Mono',monospace;display:flex;justify-content:space-between}.flow-stack i{font-style:normal;color:var(--blue)}.flow-stack .flow-active{color:#fff;background:var(--blue);border-color:var(--blue);color:white}.flow-stack .flow-active i{color:white}.flow-connector{width:1px;height:20px;background:var(--paper-soft)}
.code-lines{display:flex;flex-direction:column;gap:10px;margin:35px 0 22px;font:clamp(9px,1vw,12px) 'DM Mono',monospace;white-space:nowrap}.code-lines span:nth-child(2),.code-lines span:nth-child(5){color:#92b1ff}.code-lines i{font-style:normal;color:#7b776d;margin-right:15px}.code-indicator{position:absolute;top:-20px;right:12px;font-size:58px;color:var(--blue)}.visual-caption{position:absolute;bottom:16px;left:19px;font:8px 'DM Mono',monospace;letter-spacing:1px;color:#ada391}
.work-disclaimer{font:11px/1.8 'DM Mono',monospace;color:#716a5e;margin:22px 0 0}
.about .section-intro{margin-bottom:70px}.about-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:11%;border-top:1px solid var(--rule-dark);padding-top:45px}
.about-lead{font:500 clamp(27px,3.4vw,45px)/1.35 'Space Grotesk',sans-serif;letter-spacing:-1.3px;margin:0}.about-lead em{color:#a69c8a}.about-right p{font-size:15px;line-height:1.9;color:var(--paper-soft);margin:0 0 28px}
.text-link{display:inline-flex;gap:45px;border-bottom:1px solid var(--paper);padding-bottom:11px;font-size:13px;font-weight:700}.text-link span{color:var(--blue)}.capabilities{margin-top:86px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--rule-dark)}.capability{padding:25px 25px 10px 0;border-right:1px solid var(--rule-dark)}.capability:not(:first-child){padding-left:24px}.capability:last-child{border-right:0}.cap-number{font:10px 'DM Mono',monospace;color:var(--blue)}.capability h3{font:500 22px 'Space Grotesk',sans-serif;letter-spacing:-.7px;margin:22px 0 10px}.capability p{font-size:12px;line-height:1.8;color:var(--paper-soft);margin:0}
.experience .section-intro{margin-bottom:70px}.timeline{border-top:1px solid var(--rule-light)}.timeline-row{display:grid;grid-template-columns:32% 1fr 22%;align-items:center;gap:25px;padding:34px 0;border-bottom:1px solid var(--rule-light)}.dates,.timeline-type{font:11px 'DM Mono',monospace;letter-spacing:.5px}.timeline-row h3{font:500 25px 'Space Grotesk',sans-serif;letter-spacing:-.7px;margin:0 0 7px}.timeline-row p{font-size:13px;color:#696153;margin:0}.timeline-row .role-detail{max-width:555px;margin-top:13px;font-size:13px;line-height:1.75;color:#514d46}.timeline-type{text-align:right;color:#696153}
.contact{padding-bottom:95px}.contact-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:62px}.contact-spark{font:64px 'Space Grotesk',sans-serif;color:var(--blue)}.contact h2{font-size:clamp(64px,8vw,115px)}.contact-bottom{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-top:45px}.contact-bottom p{font-size:15px;line-height:1.7;color:var(--paper-soft);max-width:350px;margin:0}.contact-email{display:flex;justify-content:space-between;gap:75px;min-width:245px;padding:15px 0;border-bottom:2px solid var(--blue);font:600 20px 'Space Grotesk',sans-serif}.contact-email span{color:var(--blue)}.social-links{display:flex;gap:32px;margin-top:95px;border-top:1px solid var(--rule-dark);padding-top:22px;font:11px 'DM Mono',monospace}.social-links a:hover{color:#8faeff}
.footer{display:flex;justify-content:space-between;gap:20px;padding-top:30px;padding-bottom:32px;border-top:1px solid var(--rule-dark);font:10px 'DM Mono',monospace;color:var(--paper-soft);letter-spacing:.7px}.footer a{color:var(--paper)}
@media(max-width:900px){.hero h1{font-size:clamp(70px,10vw,110px)}.project-art{padding:25px}.artboard{padding:16px}.art-nodes span{font-size:9px;padding:11px 6px}.wrap{width:calc(100% - 56px)}}
@media(max-width:680px){.wrap{width:calc(100% - 38px)}.header{height:77px;gap:15px}.brand-icon{height:37px;width:37px;font-size:16px}.brand-text{font-size:9px}.header nav{gap:14px;font-size:11px}.header nav a[href='#experience']{display:none}.header-contact{font-size:11px}.header-contact span{margin-left:5px}.hero{padding-top:75px}.hero-overline{font-size:9px}.hero-no{display:none}.hero h1{font-size:clamp(48px,11vw,80px);margin:42px 0 40px;letter-spacing:-.07em}.hero-bottom p{font-size:15px}.round-link{width:55px;height:55px;font-size:22px}.hero-end{margin-top:76px;font-size:8px}.blue-band{height:5px}.work,.about,.experience,.contact{padding:75px 0}.section-intro{grid-template-columns:1fr;gap:30px;margin-bottom:40px}.section-intro h2,.contact h2{font-size:clamp(50px,11vw,75px)}.project{grid-template-columns:1fr}.project-info{min-height:300px;padding:26px 0 30px}.project-main h3{font-size:36px}.project-art{min-height:290px}.artboard{max-width:350px;padding:20px}.art-nodes span{font-size:10px;padding:12px}.about-layout{grid-template-columns:1fr;gap:26px}.about-lead{font-size:30px}.capabilities{grid-template-columns:1fr 1fr;margin-top:55px}.capability:nth-child(2){border-right:0}.capability:nth-child(n+3){border-top:1px solid var(--rule-dark)}.capability:nth-child(3){padding-left:0}.timeline-row{grid-template-columns:100px 1fr;gap:15px}.timeline-row h3{font-size:21px}.timeline-type{display:none}.contact-head{margin-bottom:40px}.contact-spark{font-size:40px}.contact-bottom{align-items:start;flex-direction:column}.contact-email{width:100%}.social-links{margin-top:65px}.footer{flex-wrap:wrap;line-height:1.8}.footer span:nth-child(2){display:none}}
