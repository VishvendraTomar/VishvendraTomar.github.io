---
import { queue } from '../i18n/simulators';
import type { Lang } from '../i18n/config';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = queue[lang];
---
<section class="queue-sim" aria-labelledby="queue-sim-title" data-t={JSON.stringify(t)}>
  <div class="qs-head">
    <h2 id="queue-sim-title">{t.title}</h2>
    <p>{t.intro}</p>
    <p class="qs-note">{t.note}</p>
  </div>
  <div class="qs-controls">
    <button type="button" data-act="outage" class="qs-primary">{t.outageOn}</button>
    <button type="button" data-act="kill">{t.kill}</button>
    <button type="button" data-act="rush">{t.rush}</button>
    <button type="button" data-act="bad">{t.bad}</button>
    <button type="button" data-act="requeue">{t.requeue}</button>
    <label class="qs-toggle"><input type="checkbox" checked data-check/> {t.statusCheck}</label>
    <span class="qs-spacer"></span>
    <button type="button" data-act="pause" class="qs-quiet">{t.pause}</button>
    <button type="button" data-act="reset" class="qs-quiet">{t.reset}</button>
  </div>
  <div class="qs-board">
    <div class="qs-col"><h3>{t.colQueue}</h3><ul class="qs-queue" data-queue></ul></div>
    <div class="qs-col"><h3>{t.colWorkers}</h3><div class="qs-workers" data-workers></div></div>
    <div class="qs-col"><h3>{t.colGov}</h3><div class="qs-gov" data-gov></div></div>
    <div class="qs-col"><h3>{t.colOut}</h3><div class="qs-out" data-out></div></div>
  </div>
  <p class="qs-invariant" data-invariant aria-live="polite"></p>
  <ul class="qs-log" data-log aria-live="polite"></ul>
</section>
<script>
  const root = document.querySelector<HTMLElement>('.queue-sim');
  if (root) {
    const T = JSON.parse(root.dataset.t || '{}');
    const f = (s: string, v: Record<string, string | number> = {}) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const check = root.querySelector<HTMLInputElement>('[data-check]')!;
    const TICK = 100, SEND = 1400, CHECK = 700, RESTART = 2500, MAX_ATTEMPTS = 5, AUTO_LIMIT = 30, FEED_EVERY = 1700;

    type Job = { id: number; attempts: number; bad: boolean; unknown: boolean; readyAt: number; status: 'queued' | 'inflight' | 'accepted' | 'dlq'; reason?: string };
    type Worker = { n: number; mode: 'idle' | 'sending' | 'checking' | 'crashed'; job: Job | null; start: number; until: number };
    let s: { t: number; nextId: number; jobs: Job[]; workers: Worker[]; govUp: boolean; gov: Set<number>; dups: number; retries: number; autoMade: number; lastFeed: number; running: boolean; log: [string, string][] };

    const log = (text: string, tone = '') => { s.log.push([text, tone]); if (s.log.length > 40) s.log.shift(); };
    function reset() {
      s = { t: 0, nextId: 1041, jobs: [], workers: [1, 2, 3].map(n => ({ n, mode: 'idle', job: null, start: 0, until: 0 })), govUp: true, gov: new Set(), dups: 0, retries: 0, autoMade: 0, lastFeed: -FEED_EVERY, running: s?.running ?? false, log: [] };
      ($('[data-act=outage]')).textContent = T.outageOn;
      render();
    }
    function create(bad = false) {
      const job: Job = { id: s.nextId++, attempts: 0, bad, unknown: false, readyAt: s.t, status: 'queued' };
      s.jobs.push(job);
      log(bad ? f(T.log.bad, { id: job.id }) : f(T.log.created, { id: job.id }), bad ? 'warn' : '');
    }
    function finish(w: Worker) {
      const job = w.job!;
      if (w.mode === 'checking') {
        if (s.gov.has(job.id)) { job.status = 'accepted'; job.unknown = false; log(f(T.log.found, { id: job.id }), 'good'); }
        else { job.unknown = false; log(f(T.log.notFound, { id: job.id })); w.mode = 'sending'; w.start = s.t; w.until = s.t + SEND; return; }
      } else if (!s.govUp) {
        job.attempts++; s.retries++;
        if (job.attempts >= MAX_ATTEMPTS) { job.status = 'dlq'; job.reason = T.reasonExhausted; log(f(T.log.exhausted, { id: job.id }), 'bad'); }
        else {
          // Exponential backoff with jitter: base doubles each attempt, randomised so retries spread out.
          const base = Math.min(1000 * 2 ** (job.attempts - 1), 8000);
          const wait = Math.round(base * (0.5 + Math.random()));
          job.status = 'queued'; job.readyAt = s.t + wait;
          log(f(T.log.transient, { id: job.id, a: job.attempts, s: (wait / 1000).toFixed(1) }), 'warn');
        }
      } else if (job.bad) {
        job.status = 'dlq'; job.reason = T.reasonRejected; log(f(T.log.rejected, { id: job.id }), 'bad');
      } else {
        if (s.gov.has(job.id)) { s.dups++; log(f(T.log.duplicate, { id: job.id }), 'bad'); }
        s.gov.add(job.id); job.status = 'accepted'; job.unknown = false; log(f(T.log.accepted, { id: job.id }), 'good');
      }
      w.mode = 'idle'; w.job = null;
    }
    function tick() {
      s.t += TICK;
      if (s.autoMade < AUTO_LIMIT && s.t - s.lastFeed >= FEED_EVERY) { create(); s.autoMade++; s.lastFeed = s.t; }
      for (const w of s.workers) {
        if (w.mode === 'crashed' && s.t >= w.until) { w.mode = 'idle'; log(f(T.log.restarted, { w: w.n })); }
        if (w.mode === 'idle') {
          const job = s.jobs.find(j => j.status === 'queued' && j.readyAt <= s.t);
          if (job) {
            job.status = 'inflight'; w.job = job; w.start = s.t;
            if (job.unknown && check.checked) { w.mode = 'checking'; w.until = s.t + CHECK; }
            else { w.mode = 'sending'; w.until = s.t + SEND; job.unknown = false; }
          }
        } else if ((w.mode === 'sending' || w.mode === 'checking') && s.t >= w.until) finish(w);
      }
      render();
    }
    function kill() {
      const busy = s.workers.filter(w => w.mode === 'sending' || w.mode === 'checking');
      if (!busy.length) { log(T.log.noBusy); render(); return; }
      const w = busy.sort((a, b) => (s.t - b.start) - (s.t - a.start))[0];
      const job = w.job!;
      // Past the halfway point the request reached Dimona: it was accepted, but the answer is lost with the worker.
      if (w.mode === 'sending' && (s.t - w.start) / SEND >= 0.5 && s.govUp && !job.bad) s.gov.add(job.id);
      job.status = 'queued'; job.readyAt = s.t; job.unknown = true;
      s.jobs.splice(s.jobs.indexOf(job), 1); s.jobs.unshift(job);
      w.mode = 'crashed'; w.job = null; w.until = s.t + RESTART;
      log(f(T.log.killed, { w: w.n, id: job.id }), 'bad');
      render();
    }
    const chip = (j: Job) => {
      const wait = j.readyAt > s.t;
      return `<li class="qs-chip${wait ? ' wait' : ''}${j.bad ? ' bad' : ''}${j.unknown ? ' unk' : ''}"><b>#${j.id}</b>${wait ? `<small>${f(T.retryIn, { s: ((j.readyAt - s.t) / 1000).toFixed(1) })}</small>` : j.unknown ? '<small>?</small>' : ''}</li>`;
    };
    function render() {
      const queued = s.jobs.filter(j => j.status === 'queued');
      $('[data-queue]').innerHTML = queued.length ? queued.slice(0, 9).map(chip).join('') + (queued.length > 9 ? `<li class="qs-more">${f(T.more, { n: queued.length - 9 })}</li>` : '') : `<li class="qs-empty">${T.empty}</li>`;
      $('[data-workers]').innerHTML = s.workers.map(w => {
        const p = w.job ? Math.min(1, (s.t - w.start) / (w.until - w.start)) : 0;
        const label = w.mode === 'idle' ? T.idle : w.mode === 'crashed' ? T.crashed : f(w.mode === 'sending' ? T.sending : T.checking, { id: w.job!.id });
        return `<div class="qs-worker" data-mode="${w.mode}"><span>${T.worker} ${w.n}</span><i>${label}</i><div class="qs-bar"><div style="width:${(p * 100).toFixed(0)}%"></div></div></div>`;
      }).join('');
      $('[data-gov]').innerHTML = `<div class="qs-govbox" data-up="${s.govUp}"><span class="qs-dot"></span>${s.govUp ? T.up : T.down}</div><dl><div><dt>${T.retries}</dt><dd>${s.retries}</dd></div><div class="${s.dups ? 'qs-alarm' : ''}"><dt>${T.duplicates}</dt><dd>${s.dups}</dd></div></dl>`;
      const acc = s.jobs.filter(j => j.status === 'accepted');
      const dlq = s.jobs.filter(j => j.status === 'dlq');
      $('[data-out]').innerHTML = `<div class="qs-acc"><span>${T.accepted}</span><b>${acc.length}</b><div class="qs-dots">${acc.slice(-48).map(() => '<i></i>').join('')}</div></div><div class="qs-dlq"><span>${T.deadLetter}</span><b>${dlq.length}</b><ul>${dlq.slice(-4).map(j => `<li>#${j.id} · ${j.reason}</li>`).join('')}</ul></div>`;
      $('[data-invariant]').textContent = f(T.invariant, { c: s.jobs.length, a: acc.length, d: dlq.length, p: s.jobs.length - acc.length - dlq.length });
      $('[data-log]').innerHTML = s.log.slice(-6).map(([text, tone]) => `<li data-tone="${tone}">${text}</li>`).join('');
    }

    let timer = 0;
    let userPaused = false;
    const setRunning = (on: boolean) => {
      s.running = on; clearInterval(timer);
      if (on) timer = window.setInterval(tick, TICK);
      $('[data-act=pause]').textContent = on ? T.pause : T.play;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach(b => b.addEventListener('click', () => {
      const act = b.dataset.act;
      if (act === 'outage') { s.govUp = !s.govUp; b.textContent = s.govUp ? T.outageOn : T.outageOff; log(s.govUp ? T.log.up : T.log.down, s.govUp ? 'good' : 'bad'); }
      if (act === 'kill') { kill(); if (!s.running) { setRunning(true); userPaused = false; } return; }
      if (act === 'rush') { log(T.log.rush, 'warn'); for (let i = 0; i < 12; i++) create(); }
      if (act === 'bad') create(true);
      if (act === 'requeue') { const d = s.jobs.filter(j => j.status === 'dlq'); d.forEach(j => { j.status = 'queued'; j.attempts = 0; j.bad = false; j.readyAt = s.t; }); if (d.length) log(f(T.log.requeued, { n: d.length }), 'good'); }
      if (act === 'pause') { setRunning(!s.running); userPaused = !s.running; return; }
      if (act === 'reset') { reset(); }
      if (!s.running) { setRunning(true); userPaused = false; }
      render();
    }));

    reset();
    // Start when the simulator scrolls into view, and pause it while it is out of sight.
    new IntersectionObserver(([e]) => { if (e.isIntersecting && !userPaused) setRunning(true); else if (!e.isIntersecting && s.running) setRunning(false); }, { threshold: 0.25 }).observe(root);
  }
</script>
<style is:global>
.queue-sim { padding: clamp(1rem, 4vw, 3rem); background: #1e1e1c; color: #f1e9da; border: 1px solid #57554e; font-family: 'DM Sans', system-ui, sans-serif; }
.entry > section.queue-sim { max-width: none; margin: 0 0 clamp(2rem, 5vw, 4rem); border: 0; }
.qs-head h2 { margin: 0; font: italic 400 clamp(1.9rem, 3.3vw, 3.1rem)/1.08 Georgia, 'Times New Roman', serif; letter-spacing: -.045em; }
.qs-head p { margin: .65rem 0 0; color: #d8cbb3; max-width: 66ch; line-height: 1.6; }
.qs-head .qs-note { font-size: .85rem; color: #8e8a80; margin-bottom: 1.3rem; }
.qs-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-bottom: 1.4rem; }
.qs-controls button { font: 600 .88rem/1 'DM Sans', system-ui, sans-serif; padding: .7rem .9rem; color: #f1e9da; background: transparent; border: 1px solid #a9a08f; cursor: pointer; }
.qs-controls button:hover { border-color: #f1e9da; }
.qs-controls .qs-primary { background: #2f6bff; border-color: #2f6bff; color: #fff; }
.qs-controls .qs-quiet { border-color: #57554e; color: #b4aa98; }
.qs-toggle { display: inline-flex; gap: .45rem; align-items: center; font-size: .88rem; color: #d8cbb3; cursor: pointer; margin-left: .3rem; }
.qs-toggle input { accent-color: #2f6bff; width: 1.05rem; height: 1.05rem; }
.qs-spacer { flex: 1; }
.qs-board { display: grid; grid-template-columns: 1.1fr 1.2fr .8fr 1.1fr; gap: 0; border: 1px solid #57554e; }
.qs-col { position: relative; padding: 1rem; min-height: 15rem; min-width: 0; }
.qs-col + .qs-col { border-left: 1px solid #57554e; }
.qs-col + .qs-col::before { content: '→'; position: absolute; left: -.55rem; top: 2.4rem; width: 1.1rem; text-align: center; background: #1e1e1c; color: #2f6bff; font-size: .9rem; }
.qs-col h3 { margin: 0 0 .8rem; font: 500 .72rem/1 'DM Mono', ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; color: #b4aa98; }
.qs-queue { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; }
.qs-chip { display: flex; justify-content: space-between; gap: .5rem; padding: .4rem .55rem; border: 1px solid #a9a08f; font: .78rem/1.3 'DM Mono', ui-monospace, monospace; }
.qs-chip small { color: #afc6ff; }
.qs-chip.wait { border-style: dashed; border-color: #afc6ff; color: #d8cbb3; }
.qs-chip.bad { border-color: #f09a88; }
.qs-chip.unk { border-color: #f2c66d; }
.qs-chip.unk small { color: #f2c66d; }
.qs-more, .qs-empty { font: .75rem 'DM Mono', ui-monospace, monospace; color: #8e8a80; padding: .3rem 0; }
.qs-workers { display: flex; flex-direction: column; gap: .55rem; }
.qs-worker { padding: .55rem .65rem; border: 1px solid #57554e; font: .78rem/1.35 'DM Mono', ui-monospace, monospace; }
.qs-worker i { display: block; font-style: normal; color: #8e8a80; font-size: .72rem; text-transform: uppercase; margin: .15rem 0 .4rem; }
.qs-bar { height: 3px; background: #33322d; }
.qs-bar div { height: 100%; background: #2f6bff; }
.qs-worker[data-mode=sending] { border-color: #2f6bff; } .qs-worker[data-mode=sending] i { color: #afc6ff; }
.qs-worker[data-mode=checking] { border-color: #f2c66d; } .qs-worker[data-mode=checking] i { color: #f2c66d; } .qs-worker[data-mode=checking] .qs-bar div { background: #f2c66d; }
.qs-worker[data-mode=crashed] { border-color: #e0735f; text-decoration: line-through; text-decoration-color: #e0735f; } .qs-worker[data-mode=crashed] i { color: #f09a88; }
.qs-govbox { display: flex; align-items: center; gap: .5rem; padding: .8rem; border: 1px solid #8fd6a8; font: 600 .95rem 'DM Sans', system-ui, sans-serif; }
.qs-govbox[data-up=false] { border-color: #e0735f; color: #f09a88; }
.qs-dot { width: .6rem; height: .6rem; border-radius: 50%; background: #8fd6a8; box-shadow: 0 0 0 4px #8fd6a833; }
.qs-govbox[data-up=false] .qs-dot { background: #e0735f; box-shadow: 0 0 0 4px #e0735f33; }
.qs-gov dl { margin: .9rem 0 0; display: grid; gap: .5rem; }
.qs-gov dl div { display: flex; justify-content: space-between; font-size: .85rem; color: #b4aa98; border-top: 1px solid #45433d; padding-top: .45rem; }
.qs-gov dd { margin: 0; font: 600 .95rem 'DM Mono', ui-monospace, monospace; color: #f1e9da; }
.qs-gov .qs-alarm, .qs-gov .qs-alarm dd { color: #f09a88; }
.qs-out { display: grid; gap: .9rem; }
.qs-acc, .qs-dlq { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: .3rem; font-size: .85rem; color: #b4aa98; }
.qs-acc b, .qs-dlq b { font: 500 1.5rem/1 'Space Grotesk', 'DM Sans', sans-serif; color: #8fd6a8; }
.qs-dlq b { color: #f09a88; }
.qs-dots { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 3px; min-height: 9px; }
.qs-dots i { width: 9px; height: 9px; background: #8fd6a8; }
.qs-dlq ul { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; font: .72rem/1.5 'DM Mono', ui-monospace, monospace; color: #f09a88; }
.qs-invariant { margin: 1rem 0 .6rem; padding: .7rem 1rem; border-left: 3px solid #8fd6a8; background: #292925; font: .82rem/1.5 'DM Mono', ui-monospace, monospace; color: #d8cbb3; }
.qs-log { list-style: none; margin: 0; padding: .7rem .9rem; min-height: 8.5rem; background: #151513; border: 1px solid #57554e; font: .78rem/1.6 'DM Mono', ui-monospace, monospace; color: #d8cbb3; }
.qs-log [data-tone=bad] { color: #f09a88; } .qs-log [data-tone=good] { color: #8fd6a8; } .qs-log [data-tone=warn] { color: #f2c66d; }
@media (max-width: 860px) {
  .qs-board { grid-template-columns: 1fr 1fr; }
  .qs-col:nth-child(3) { border-left: 0; }
  .qs-col:nth-child(n+3) { border-top: 1px solid #57554e; }
  .qs-col:nth-child(3)::before { display: none; }
  .qs-col { min-height: 11rem; }
}
@media (max-width: 520px) {
  .qs-board { grid-template-columns: 1fr; }
  .qs-col + .qs-col { border-left: 0; border-top: 1px solid #57554e; }
  .qs-col + .qs-col::before { content: '↓'; left: 50%; top: -.65rem; transform: translateX(-50%); }
  .qs-spacer { display: none; }
}
</style>
