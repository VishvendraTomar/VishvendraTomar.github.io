---
import { agent } from '../i18n/simulators';
import type { Lang } from '../i18n/config';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = agent[lang];
const steps = t.steps;
---
<section class="agent-sim" aria-labelledby="agent-sim-title" data-t={JSON.stringify(t)}>
  <div class="as-head">
    <h2 id="agent-sim-title">{t.title}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="as-controls">
    <button type="button" data-run="normal">{t.runNormal}</button>
    <button type="button" data-run="crash" class="as-primary">{t.runCrash}</button>
    <label class="as-toggle"><input type="checkbox" checked data-checkpoints/> {t.checkpoints}</label>
  </div>
  <div class="as-body">
    <ol class="as-steps">
      {steps.map(([title, description], i) => <li data-step={i}><span class="as-num">{String(i + 1).padStart(2, '0')}</span><div><strong>{title}</strong><p>{description}</p></div><span class="as-state">{t.waiting}</span></li>)}
    </ol>
    <div class="as-side">
      <div class="as-workers"><span data-worker="A">{t.workerA} <i>{t.idle}</i></span><span data-worker="B">{t.workerB} <i>{t.idle}</i></span></div>
      <ul class="as-log" aria-live="polite"><li>{t.start}</li></ul>
      <p class="as-note" data-note hidden></p>
    </div>
  </div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('.agent-sim');
  if (root) {
    const items = [...root.querySelectorAll<HTMLLIElement>('.as-steps li')];
    const log = root.querySelector<HTMLUListElement>('.as-log')!;
    const note = root.querySelector<HTMLParagraphElement>('[data-note]')!;
    const checkpoints = root.querySelector<HTMLInputElement>('[data-checkpoints]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-run]')];
    const workers = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-worker]')].map(el => [el.dataset.worker!, el]));
    const T = JSON.parse(root.dataset.t || '{}');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const delay = (ms: number) => new Promise(r => setTimeout(r, reduced ? 0 : ms));
    let runId = 0;

    const setStep = (i: number, state: string, label: string) => { items[i].dataset.state = state; items[i].querySelector('.as-state')!.textContent = label; };
    const setWorker = (w: string, state: string, label: string) => { workers[w].dataset.state = state; workers[w].querySelector('i')!.textContent = label; };
    const write = (text: string, tone = '') => { const li = document.createElement('li'); li.textContent = text; if (tone) li.dataset.tone = tone; log.append(li); log.scrollTop = log.scrollHeight; };

    async function run(mode: 'normal' | 'crash') {
      const id = ++runId;
      const live = () => id === runId;
      const withCheckpoints = checkpoints.checked;
      items.forEach((_, i) => setStep(i, '', T.waiting));
      setWorker('A', '', T.idle); setWorker('B', '', T.idle);
      log.replaceChildren(); note.hidden = true;
      const runStep = async (i: number, worker: string, again = false) => {
        setStep(i, 'running', T.running + ' · ' + worker); setWorker(worker, 'busy', T.busy + ' ' + (i + 1));
        await delay(650); if (!live()) return false;
        setStep(i, again ? 'repeat' : 'done', again ? T.ranAgain : withCheckpoints ? T.checkpointed : T.done);
        write(T.log.finished.replace('{w}', worker).replace('{n}', String(i + 1)) + (withCheckpoints ? T.log.checkpointSaved : '') + '.', again ? 'bad' : '');
        if (again && i === 1) write(T.log.twice, 'bad');
        return true;
      };

      write(T.log.claimA);
      for (let i = 0; i < items.length; i++) {
        if (mode === 'crash' && i === 3) {
          setStep(i, 'running', T.running + ' · A'); setWorker('A', 'busy', T.busy + ' 4');
          await delay(700); if (!live()) return;
          setStep(i, 'lost', T.lost); setWorker('A', 'dead', T.crashed);
          write(T.log.dies, 'bad');
          await delay(900); if (!live()) return;
          write(T.log.claimB);
          if (withCheckpoints) {
            write(T.log.restored, 'good');
            for (let j = 0; j < 3; j++) setStep(j, 'restored', T.fromCheckpoint);
            await delay(500); if (!live()) return;
          } else {
            write(T.log.noCheckpoint, 'bad');
            for (let j = 0; j < 3; j++) { if (!(await runStep(j, 'B', true))) return; }
          }
          for (let j = 3; j < items.length; j++) { if (!(await runStep(j, 'B'))) return; }
          setWorker('B', 'done', T.finished);
          note.textContent = withCheckpoints ? T.noteGood : T.noteBad;
          note.dataset.tone = withCheckpoints ? 'good' : 'bad'; note.hidden = false;
          return;
        }
        if (!(await runStep(i, 'A'))) return;
      }
      setWorker('A', 'done', T.finished);
      note.textContent = T.noteNormal;
      note.dataset.tone = ''; note.hidden = false;
    }
    buttons.forEach(b => b.addEventListener('click', () => run(b.dataset.run as 'normal' | 'crash')));
  }
</script>
<style>
.agent-sim { padding: clamp(1rem, 4vw, 3rem); background: #1e1e1c; color: #f1e9da; border: 1px solid #57554e; font-family: 'DM Sans', system-ui, sans-serif; }
:global(.entry) > .agent-sim { max-width: none; margin: 0 0 clamp(2rem, 5vw, 4rem); border: 0; }
.as-head h2 { margin: 0; font: italic 400 clamp(1.9rem, 3.3vw, 3.1rem)/1.08 Georgia, 'Times New Roman', serif; letter-spacing: -.045em; }
.as-head p { margin: .65rem 0 1.4rem; color: #d8cbb3; max-width: 62ch; line-height: 1.6; }
.as-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem 1rem; margin-bottom: 1.5rem; }
.as-controls button { font-weight: 600; font-size: .95rem; line-height: 1; padding: .75rem 1rem; color: #f1e9da; background: transparent; border: 1px solid #a9a08f; font-family: inherit; cursor: pointer; }
.as-controls button:hover { border-color: #f1e9da; }
.as-controls .as-primary { background: #2459e0; border-color: #2459e0; color: #fff; }
.as-toggle { display: inline-flex; gap: .45rem; align-items: center; font-size: .92rem; color: #d8cbb3; cursor: pointer; }
.as-toggle input { accent-color: var(--brand-blue); width: 1.05rem; height: 1.05rem; }
.as-body { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(1rem, 3vw, 2.5rem); }
.as-steps { list-style: none; margin: 0; padding: 0; }
.as-steps li { display: grid; grid-template-columns: 2.2rem 1fr auto; gap: .2rem .7rem; align-items: start; padding: .7rem 0; border-top: 1px solid #57554e; transition: background .2s, opacity .2s; }
.as-num { font: .85rem/1.6 'DM Mono', ui-monospace, monospace; color: #8e8a80; }
.as-steps strong { font-weight: 650; }
.as-steps p { margin: .15rem 0 0; font-size: .9rem; line-height: 1.45; color: #b4aa98; }
.as-state { font: .72rem/1.6 'DM Mono', ui-monospace, monospace; text-transform: uppercase; letter-spacing: .05em; color: #8e8a80; white-space: nowrap; }
.as-steps li[data-state=running] { background: #2f6bff22; }
.as-steps li[data-state=running] .as-state, .as-steps li[data-state=running] .as-num { color: #afc6ff; }
.as-steps li[data-state=done] .as-state, .as-steps li[data-state=done] .as-num { color: #8fd6a8; }
.as-steps li[data-state=restored] { opacity: .75; }
.as-steps li[data-state=restored] .as-state { color: #afc6ff; }
.as-steps li[data-state=lost] .as-state, .as-steps li[data-state=repeat] .as-state { color: #f09a88; }
.as-steps li[data-state=lost] { background: #e0735f1f; }
.as-workers { display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 1rem; }
.as-workers span { flex: 1; min-width: 8rem; padding: .6rem .8rem; border: 1px solid #686358; font: .85rem/1.4 'DM Mono', ui-monospace, monospace; }
.as-workers i { display: block; font-style: normal; color: #8e8a80; text-transform: uppercase; font-size: .72rem; }
.as-workers [data-state=busy] { border-color: #2f6bff; } .as-workers [data-state=busy] i { color: #afc6ff; }
.as-workers [data-state=dead] { border-color: #e0735f; text-decoration: line-through; } .as-workers [data-state=dead] i { color: #f09a88; }
.as-workers [data-state=done] i { color: #8fd6a8; }
.as-log { list-style: none; margin: 0; padding: .8rem; min-height: 9rem; max-height: 16rem; overflow: auto; background: #151513; border: 1px solid #57554e; font: .82rem/1.55 'DM Mono', ui-monospace, monospace; color: #d8cbb3; }
.as-log li + li { margin-top: .35rem; }
.as-log [data-tone=bad] { color: #f09a88; }
.as-log [data-tone=good] { color: #8fd6a8; }
.as-note { margin: 1rem 0 0; padding: .8rem 1rem; border-left: 3px solid var(--brand-blue); background: #292925; font-size: .95rem; }
.as-note[data-tone=bad] { border-color: #e0735f; }
.as-note[data-tone=good] { border-color: #8fd6a8; }
@media (max-width: 760px) { .as-toggle { min-height: 44px; } .as-controls button { min-height: 44px; flex: 1 1 auto; } .as-log { font-size: .85rem; } .as-body { grid-template-columns: 1fr; } .as-steps li { grid-template-columns: 2rem 1fr; } .as-state { grid-column: 2; } }
</style>
