---
import { type Figure } from '../lib/content';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/config';
const { id, compact = false, featured = false, lang = 'en' } = Astro.props as {id: Figure, compact?: boolean, featured?: boolean, lang?: Lang};
const [title, description] = ui[lang].figures[id];
---
<figure class:list={['diagram', { compact, featured }]}>
  <a href={'/diagrams/'+id+'.svg'} aria-label={ui[lang].openDiagram + ': ' + title}><picture>{featured && <source media="(min-width: 720px)" srcset={'/diagrams/'+id+'-wide.svg'}/>}<img src={'/diagrams/'+id+'.svg'} alt={description} loading={featured ? "eager" : "lazy"} /></picture></a>
  {!compact && <figcaption><strong>{title}</strong> · {description}</figcaption>}
</figure>
