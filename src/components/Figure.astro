---
import { figures, type Figure } from '../lib/content';
const { id, compact = false, featured = false } = Astro.props as {id: Figure, compact?: boolean, featured?: boolean};
const [title, description] = figures[id];
---
<figure class:list={['diagram', { compact, featured }]}>
  <a href={'/diagrams/'+id+'.svg'} aria-label={'Open full-size diagram: '+title}><picture>{featured && <source media="(min-width: 720px)" srcset={'/diagrams/'+id+'-wide.svg'}/>}<img src={'/diagrams/'+id+'.svg'} alt={description} loading={featured ? "eager" : "lazy"} /></picture></a>
  {!compact && <figcaption><strong>{title}</strong> · {description}</figcaption>}
</figure>
